# Copy to deploy.env (gitignored). Used by deploy.sh.
SSH_HOST=myserver              # ssh alias or user@host
DEST=/var/www/example.com/family-planner   # webroot folder that holds index.php
WEB_USER=www-data              # owner to chown to (only used when SUDO_PASS is set)
SITE_URL=https://example.com/family-planner/
# SUDO_PASS=...                # only if the webroot is owned by another user; otherwise leave unset
